. ${ROOT_DIR}/${KERNEL_DIR}/build.config.common
. ${ROOT_DIR}/${KERNEL_DIR}/build.config.aarch64

ARCH=arm64
DEFCONFIG="rock_gki_defconfig"
PRE_LEVEL_CONF=rock_gki_defconfig
PRE_DEFCONFIG_CMDS="KCONFIG_CONFIG=${ROOT_DIR}/${KERNEL_DIR}/arch/arm64/configs/${DEFCONFIG} ${ROOT_DIR}/${KERNEL_DIR}/scripts/kconfig/merge_config.sh -m -r ${ROOT_DIR}/${KERNEL_DIR}/arch/arm64/configs/mgk_64_k510_defconfig ${ROOT_DIR}/${KERNEL_DIR}/arch/arm64/configs/gki_defconfig ${ROOT_DIR}/${KERNEL_DIR}/kernel/configs/rock.config"
POST_DEFCONFIG_CMDS="rm ${ROOT_DIR}/${KERNEL_DIR}/arch/arm64/configs/${DEFCONFIG}"
KERNEL_DIR=common
BUILD_TARGET_PRODUCT=rock
KRN_PROJECT=ROCK
TARGET_BUILD_VARIANT=user
MTK_PLATFORM=mt6789

FILES="
arch/arm64/boot/Image
arch/arm64/boot/Image.gz
arch/arm64/boot/dts/mediatek/rock.dtb
arch/arm64/boot/dts/mediatek/mt6789.dtb
"

DO_NOT_STRIP_MODULES=0
SKIP_CP_KERNEL_HDR=1
MAKE_GOALS="${MAKE_GOALS} Image.gz dtbs"

ABI_OUT_TAG="mtk"
KMI_SYMBOL_LIST=android/abi_gki_aarch64_mtk
GKI_MODULES_LIST=android/gki_aarch64_modules
ABI_DEFINITION=android/abi_gki_aarch64.xml
ADDITIONAL_KMI_SYMBOL_LISTS="
android/abi_gki_aarch64_xiaomi
"